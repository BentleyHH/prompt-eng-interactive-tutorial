# Zugangsdaten für den Produktivbetrieb. Kopieren nach `.env` und ausfüllen.
# NIEMALS die echte .env committen (steht in .gitignore).

# --- Claude / Anthropic (Rechnungsextraktion) ---
ANTHROPIC_API_KEY=

# --- Gmail (Ingestion) ---
# Pfad zur OAuth-Client-Datei aus der Google Cloud Console
GMAIL_CREDENTIALS_JSON=./secrets/gmail_credentials.json
# Pfad, unter dem das Zugriffstoken gespeichert wird (wird automatisch erzeugt)
GMAIL_TOKEN_JSON=./secrets/gmail_token.json

# --- Microsoft OneDrive (Ablage via Graph API) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
ONEDRIVE_DRIVE_ID=
