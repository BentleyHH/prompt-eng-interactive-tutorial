# ETAF backend — Zugriffsschutz
# config.php, SQLite-Dateien, SQL-Dumps und reine Include-Dateien niemals ausliefern.
<FilesMatch "^(config\.php|config\.sample\.php|.*\.sqlite|.*\.sql|.*\.sql\.gz|db\.php|lib\.php|mailer\.php|mailfetch\.php|ai\.php|automation\.php)$">
  Require all denied
</FilesMatch>

# Include-Dateien (db/lib/mailer/mailfetch/ai/automation) werden nur per include
# genutzt, nie direkt. api.php, respond.php, plan.php usw. bleiben erreichbar.

# UTF-8
AddDefaultCharset UTF-8
