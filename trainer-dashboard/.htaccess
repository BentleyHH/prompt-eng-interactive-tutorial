# ETAF Trainer-Koordination — statische Auslieferung
# UTF-8 erzwingen (verhindert Umlaut-Probleme, falls der Server sonst Latin-1 sendet)
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddCharset UTF-8 .html
</IfModule>

# Die sichtbare Kopie htaccess.txt nicht ausliefern (falls nach dem Umbenennen liegen geblieben)
<Files "htaccess.txt">
  Require all denied
</Files>

# Nach Updates sofort den neuen Stand zeigen: der Browser darf index.html und
# config.js nicht stumpf aus dem Cache nehmen, sondern fragt kurz beim Server
# nach, ob es eine neuere Fassung gibt (kostet fast nichts, verhindert alte Ansichten).
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|config\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
