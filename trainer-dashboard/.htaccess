# ETAF Trainer-Koordination — statische Auslieferung
# UTF-8 erzwingen (verhindert Umlaut-Probleme, falls der Server sonst Latin-1 sendet)
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddCharset UTF-8 .html
</IfModule>

# Die sichtbare Kopie htaccess.txt nicht ausliefern (falls nach dem Umbenennen liegen geblieben)
<Files "htaccess.txt">
  Require all denied
</Files>

# Nach Updates sofort den neuen Stand zeigen: der Browser darf index.html und
# config.js nicht stumpf aus dem Cache nehmen, sondern fragt kurz beim Server
# nach, ob es eine neuere Fassung gibt (kostet fast nichts, verhindert alte Ansichten).
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|config\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Immer verschluesselt: unverschluesselte Aufrufe sofort auf https umleiten,
# und dem Browser per HSTS einschaerfen, die Domain nur noch per https zu laden.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Schutz-Header fuer die ganze Anwendung
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  # Das Cockpit hat in Suchmaschinen nichts verloren
  Header always set X-Robots-Tag "noindex, nofollow"
  # Browser-Funktionen, die die Anwendung nicht braucht, ganz abschalten
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Content-Security-Policy: nur eigene Inhalte, keine fremden Server.
  # Selbst wenn Schadcode in die Seite gelangen sollte, kann er keine
  # Daten an fremde Adressen schicken (connect-src 'self').
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'"
</IfModule>
